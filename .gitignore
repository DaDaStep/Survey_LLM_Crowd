*.fls
*.fdb_latexmk
*.toc
*.run.xml
*.bcf
*.lol
*.lot
*.lof

# Zotero / Mendeley local databases
*.bib.sav
zotero.sqlite
zotero.sqlite-journal

# ------------------------------------------------------------------
